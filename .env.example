# ── Shared ─────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgres://madar:madar@localhost:5432/madar
REDIS_URL=redis://localhost:6379

# ── API (apps/api) ─────────────────────────────────────
PORT=4000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=14
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
LOG_LEVEL=info

# ── Worker (workers/simulation) ────────────────────────
WORKER_CONCURRENCY=2

# ── Seeding (packages/db) ──────────────────────────────
# Password for the demo accounts admin@ / planner@ / viewer@madar.dev
DEMO_PASSWORD=madar-demo-2026

# ── Web (apps/web) ─────────────────────────────────────
# Server-side only: where Next.js proxies /api requests.
API_INTERNAL_URL=http://localhost:4000
# Public: where the browser opens the WebSocket.
NEXT_PUBLIC_WS_URL=http://localhost:4000
