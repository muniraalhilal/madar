{
  "name": "@madar/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --clean --sourcemap --target node22",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@madar/db": "workspace:*",
    "@madar/shared": "workspace:*",
    "@madar/sim-engine": "workspace:*",
    "bullmq": "5.58.0",
    "drizzle-orm": "0.44.7",
    "ioredis": "5.7.0",
    "pino": "9.9.0"
  },
  "devDependencies": { "@madar/config": "workspace:*", "tsup": "8.5.0", "tsx": "4.20.3" }
}
