{
  "name": "madar",
  "private": true,
  "version": "0.1.0",
  "description": "MADAR — The City in Motion. A smart-city digital twin with a deterministic traffic simulation engine.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build && pnpm -r --filter ./apps/** --filter ./workers/** run build",
    "build:packages": "pnpm -r --filter ./packages/** run build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter @madar/api --filter @madar/web --filter @madar/worker run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "db:migrate": "pnpm --filter @madar/db run migrate",
    "db:seed": "pnpm --filter @madar/db run seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.40.0",
    "@eslint/js": "^9.30.0",
    "vitest": "3.2.4"
  }
}
