{
  "name": "@madar/sim-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic mesoscopic traffic + building-energy simulation engine for MADAR.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "bench": "tsx test/bench.ts"
  },
  "devDependencies": {
    "@madar/config": "workspace:*",
    "tsup": "8.5.0",
    "tsx": "4.20.3"
  }
}
